{
  "name": "kiosk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @kiosk/api --filter @kiosk/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @kiosk/api db:generate",
    "db:migrate": "pnpm --filter @kiosk/api db:migrate"
  }
}
