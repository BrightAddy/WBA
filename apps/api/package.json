{
  "name": "@kiosk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@kiosk/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
