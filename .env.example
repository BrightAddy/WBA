# Copy to apps/api/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://kiosk:kiosk@localhost:5432/kiosk
TEST_DATABASE_URL=postgres://kiosk:kiosk@localhost:5432/kiosk_test

# 32+ random bytes, e.g. `openssl rand -base64 48`
OTP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated E.164 numbers that sign in as admin
ADMIN_PHONES=+233200000000

# WhatsApp Cloud API. Leave blank in dev: codes are printed to the API log instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved authentication template with one body param and a copy-code button
WHATSAPP_OTP_TEMPLATE=kiosk_login_code
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0

# Local photo storage (dev). Production uses R2 behind a CDN.
MEDIA_DIR=.media

# Utility template for "new order" messages to sellers. Body variables, in order:
# order code, customer name, item count, total, area
WHATSAPP_ORDER_TEMPLATE=kiosk_new_order

# ── The shared WhatsApp bot (Day 4) ──
# Meta app secret (App settings > Basic). Every webhook call is signed with it. Required in production.
WHATSAPP_APP_SECRET=
# Any string you invent. Paste the same one into Meta when you set the webhook URL
# to https://<your-api>/api/webhooks/whatsapp. Required in production.
WHATSAPP_VERIFY_TOKEN=
# The bot's number in digits only (233201234567). Turns on the storefront's "Ask on WhatsApp" button.
WHATSAPP_BOT_NUMBER=
# Leave blank to use the built-in no-AI replies (catalogue, delivery, handoff). Set it for chat ordering.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Messages one customer can send per 10 minutes before the bot stops answering.
BOT_CUSTOMER_BURST=20

# Local testing only: skip manual store approval. Never true in production.
AUTO_APPROVE_SELLERS=false

# Production: public site URL for link previews, and the built web app for the API to serve.
# PUBLIC_URL=https://kiosk.app
# WEB_DIST=../web/dist
